---
import { t } from '../lib/i18n';
const s = t(Astro.url);
---
<footer id="contato" class="site-footer">
  <div class="wrap">
    <div class="footer-inner">
      <div>
        <p class="label">{s.footerLabel}</p>
        <h2>{s.footerTitle}</h2>
        <p class="footer-sub">{s.footerSub}</p>
      </div>
      <div class="footer-links">
        <a class="footer-mail" href="mailto:beatriz081medina@gmail.com">beatriz081medina@gmail.com</a>
        <ul>
          <li><a href="https://www.linkedin.com/in/beatrizmedinaa" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base"><span>© 2026 Beatriz Medina</span><a href="#conteudo">{s.backToTop}</a></div>
  </div>
</footer>
