---
import { Image, getImage } from 'astro:assets';
import { img } from '../lib/images';
interface Item { src: string; alt: string; caption: string }
interface Props { items: Item[]; cols?: 2 | 3 | 4; phone?: boolean }
const { items, cols = 2, phone = false } = Astro.props;
const resolved = await Promise.all(items.map(async (i) => {
  const meta = img(i.src);
  const full = await getImage({ src: meta, width: Math.min(meta.width, 2000), format: 'webp' });
  return { ...i, meta, full: full.src };
}));
---
<ul class:list={['gallery', `gallery-${cols}`, { 'gallery-phone': phone }]}>
  {resolved.map((i) => (
    <li>
      <button class="zoom" type="button" data-full={i.full} aria-label={`Ampliar: ${i.alt}`}>
        <Image src={i.meta} alt={i.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 420px" loading="lazy" />
      </button>
      <span>{i.caption}</span>
    </li>
  ))}
</ul>
