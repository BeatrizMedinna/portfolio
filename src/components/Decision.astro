---
interface Props { n: string; title: string; id: string }
const { n, title, id } = Astro.props;
import { t } from '../lib/i18n';
const s = t(Astro.url);
---
<article class="decision" aria-labelledby={id}>
  <header class="decision-head">
    <h3 id={id}>{title}</h3>
    <span class="decision-tag">{s.decision} {n}</span>
  </header>
  <dl class="decision-table"><slot /></dl>
  <slot name="figure" />
</article>
