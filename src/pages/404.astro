---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada · Beatriz Medina" description="Esta página não existe ou mudou de endereço." page="none">
  <section class="notfound">
    <div class="wrap">
      <p class="kicker">Erro 404</p>
      <h1>Esta página não existe ou mudou de lugar.</h1>
      <p>Os projetos e o contato continuam na página inicial.</p>
      <a class="btn btn-primary" href="/">Voltar ao início</a>
    </div>
  </section>
</Base>
