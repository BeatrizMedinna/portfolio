---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { awards, journey } from '../data/profile';
import { img } from '../lib/images';

const process = [
  ['Pesquisa', 'Entrevistas e síntese de achados para entender o problema antes de desenhar.'],
  ['Figma', 'Fluxos, protótipos e um design system com componentes desde o início.'],
  ['SwiftUI + Claude', 'Interfaces funcionais construídas em SwiftUI, com o Claude como apoio no código.'],
  ['Simulador', 'Valido o comportamento real no simulador, não só a tela estática.'],
  ['Handoff', 'Componentes e especificações prontos para o time de desenvolvimento.'],
];

const skills = [
  { group: 'Design', items: ['Figma', 'Prototipagem em alta fidelidade', 'Design systems e componentes', 'UX Writing', 'Handoff'] },
  { group: 'Engenharia', items: ['SwiftUI', 'Xcode e simulador', 'React e React Native', 'Claude no fluxo de prototipação'] },
  { group: 'Métodos', items: ['Entrevistas', 'Síntese de achados', 'Personas', 'Jornada do usuário', 'Histórias de usuário', 'Benchmarking', 'Design Thinking'] },
];

const principles = [
  ['Transformo restrições em direção', 'Hackathons me ensinaram que tempo, escopo e recursos quase nunca são ideais. Uso essas limitações para decidir com mais objetividade e priorizar o que gera valor.'],
  ['Gosto de construir junto', 'Quase todos os meus projetos foram em times multidisciplinares. As melhores soluções vieram das conversas e da troca entre design, desenvolvimento e produto.'],
  ['Faço perguntas antes de desenhar', 'Antes de abrir o Figma, procuro entender o contexto, os objetivos do produto e o comportamento das pessoas, para que cada decisão tenha um motivo.'],
  ['Feedback faz parte do processo', 'Os projetos em que mais evoluí foram os que questionaram minhas ideias. Refino a solução com o time em vez de me apegar à primeira proposta.'],
  ['Sempre existe uma forma melhor', 'Não me contento com a primeira resposta. Exploro alternativas e reviso decisões quando vejo como simplificar a experiência.'],
];

type Award = { imgs: string[]; alt: string; caption: string };
const recognition: Award[] = [
  { imgs: ['recognition/m_m_1.jpg'], alt: 'Instituto Memaker', caption: 'Instituto Memaker: estudando expressão criativa e robótica.' },
  { imgs: ['recognition/m_m_2.jpg'], alt: 'Time premiado no Hackathon InovaTI, 3º lugar', caption: '3º lugar, Hackathon InovaTI: solução para automatizar o carregamento de carros elétricos em condomínios.' },
  { imgs: ['recognition/m_m_3.jpg', 'recognition/m_m_3_1.jpg'], alt: 'Time premiado no Hackathon InovaTI, 1º lugar', caption: '1º lugar, Hackathon InovaTI: solução para aluguel inteligente e otimizado de imóveis.' },
  { imgs: ['recognition/m_m_4.jpg'], alt: 'Time premiado no HackaCity Guará, 1º lugar', caption: '1º lugar, HackaCity Guará: solução para ampliar a reciclagem e engajar a população.' },
  { imgs: ['recognition/m_m_5.jpg'], alt: 'Time premiado no Hackideias Elas, 3º lugar', caption: '3º lugar, Hackideias Elas: solução para prevenir a violência doméstica contra mulheres.' },
  { imgs: ['recognition/m_m_6.jpg', 'recognition/m_m_6_1.jpg'], alt: 'Premiação do Hackathon Sinfor/DF', caption: '2º e 3º lugares, Hackathon Sinfor/DF: plataforma para arquitetos e clientes e um chat inteligente voltado à saúde mental.' },
  { imgs: ['recognition/m_m_7.jpg'], alt: 'Prêmio Sindesei Tech Excellence 2024', caption: 'Prêmio Sindesei Tech Excellence 2024: aluna destaque da Universidade Católica de Brasília.' },
  { imgs: ['recognition/m_m_8.jpg', 'recognition/m_m_8_1.jpg'], alt: 'Lançamento do app SETE na App Store', caption: 'Lançamento do meu primeiro app na App Store, o SETE.' },
  { imgs: ['recognition/m_m_9.jpg'], alt: 'Time premiado no Open Connections + InCoDay, 2º lugar', caption: '2º lugar, Hackathon Open Connections + InCoDay: solução para conectar talentos negros ao mercado jurídico.' },
  { imgs: ['recognition/m_m_10.jpg'], alt: 'Time premiado no Hackathon Cerrado Tech, 1º lugar', caption: '1º lugar, Hackathon Cerrado Tech: solução para produtores rurais acompanharem suas plantações.' },
  { imgs: ['recognition/m_m_11.jpg'], alt: 'Lançamento do app BorAli? Explore Brasília na App Store', caption: 'Lançamento do meu segundo app na App Store, o BorAli? Explore Brasília.' },
];
---
<Base
  title="Sobre · Beatriz Medina · Product Designer"
  description="Trajetória, forma de trabalho, competências e prêmios de Beatriz Medina, Product Designer na Apple Developer Academy."
  page="about"
  bodyClass="page-about"
>
  <section class="about-hero" id="about">
    <div class="wrap about-grid">
      <div>
        <p class="kicker">Sobre</p>
        <h1>Da pesquisa à interface, com formação técnica no caminho.</h1>
        <div class="prose">
          <p>Comecei na tecnologia ainda no ensino médio, em Recife, no curso técnico de Análise e Desenvolvimento de Sistemas do Porto Digital. Ali vi a tecnologia resolvendo problemas reais e descobri o que mais me interessava: transformar essa capacidade em experiências que fizessem sentido para as pessoas.</p>
          <p>Na graduação em Ciência da Computação, na Universidade Católica de Brasília, encontrei no Product Design uma forma de unir o conhecimento técnico à experiência do usuário. Entre hackathons, projetos em grupo e o estágio na Cria Incubator, assumir o papel de designer aconteceu de forma natural.</p>
          <p>Hoje, como Product Designer na Apple Developer Academy, desenho produtos para o ecossistema Apple e gosto de participar do processo inteiro, da compreensão do problema à interface final.</p>
        </div>
      </div>
      <figure class="about-photo">
        <Image src={img('profile.jpg')} alt="Retrato de Beatriz Medina" widths={[400, 700]} sizes="(max-width: 860px) 60vw, 360px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="block-section" id="como-trabalho">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">Como trabalho hoje</h2>
        <p class="section-title">Do achado de pesquisa ao componente pronto para o time.</p>
      </header>
      <ol class="process">
        {process.map(([t, d], i) => (
          <li><span class="p-n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block-section" id="competencias">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">Competências</h2>
        <p class="section-title">Design, engenharia e método.</p>
      </header>
      <div class="skills">
        {skills.map((s) => (
          <div><h3 class="skills-title">{s.group}</h3><ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <section class="block-section" id="principios">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">Como eu penso</h2>
        <p class="section-title">Cinco hábitos que levo de projeto em projeto.</p>
      </header>
      <ol class="principles">
        {principles.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="block-section" id="trajetoria">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">Trajetória</h2>
        <p class="section-title">Formação técnica, prática em produto.</p>
      </header>
      <table class="cv">
        <caption class="sr-only">Trajetória profissional e formação</caption>
        <tbody>
          {journey.map((j) => (
            <tr>
              <th scope="row">{j.when}{j.todo && <Todo>{j.todo}</Todo>}</th>
              <td><strong>{j.what}</strong></td>
              <td>{j.where}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="block-section" id="reconhecimento">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">Reconhecimento</h2>
        <p class="section-title">{awards.podiums} pódios em {awards.editions} edições de hackathons, {awards.wins} em 1º lugar.</p>
      </header>
      <ul class="recognition">
        {recognition.map((r) => (
          <li>
            <div class:list={['rec-imgs', { 'rec-pair': r.imgs.length > 1 }]}>
              {r.imgs.map((src, i) => (
                <Image src={img(src)} alt={r.imgs.length > 1 ? `${r.alt} (foto ${i + 1})` : r.alt} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 360px" />
              ))}
            </div>
            <p>{r.caption}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
