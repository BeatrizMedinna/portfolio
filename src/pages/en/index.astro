---
import { Image } from 'astro:assets';
import { projectsEn as projects } from '../../data/projects';
import { journeyEn as journey } from '../../data/profile';
import Base from '../../layouts/Base.astro';
import Chips from '../../components/Chips.astro';
import { img } from '../../lib/images';

const photo = img('profile.jpg');
---
<Base
  title="Beatriz Medina · Product Designer"
  description="Product Designer based in Brasília. Research, product decisions and functional prototyping for apps and systems, with three apps on the App Store."
  page="work"
  bodyClass="page-home"
>
  <section class="hero has-photo" id="top">
    <div class="wrap hero-grid">
      <div class="hero-main">
        <p class="kicker"><span class="status-dot" aria-hidden="true"></span>Product Designer</p>
        <h1>I design digital products from research to <em>working prototype</em>.</h1>
        <p class="lede">I investigate the problem, turn findings into product decisions and design interfaces for apps and systems. A Computer Science background helps me work closely with engineering and test ideas in interactive prototypes, using the technology each project needs.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#work">See projects</a>
          <a class="btn btn-quiet" href="/en/about.html">About me</a>
        </div>
      </div>
      <figure class="hero-photo">
        <Image src={photo} alt="Portrait of Beatriz Medina" widths={[160, 400, 700]} sizes="(max-width: 860px) 72px, 360px" loading="eager" fetchpriority="high" />
      </figure>
    </div>
    <div class="wrap">
      <dl class="hero-spec">
        <div><dt>Focus</dt><dd>Product Design · UX/UI</dd></div>
        <div><dt>Strength</dt><dd>Functional prototyping</dd></div>
        <div><dt>On the App Store</dt><dd>3 published apps</dd></div>
        <div><dt>Based in</dt><dd>Brasília, Brazil</dd></div>
      </dl>
    </div>
  </section>

  <section id="work" class="work">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">Selected work</h2>
        <p class="section-title">Two recent case studies in development and three products on the App Store.</p>
      </header>
      <ol class="projects">
        {projects.map((p) => (
          <li class="project">
            <div class="project-media">
              <Image src={img(p.image.src)} alt={p.image.alt} widths={[600, 900, 1300]} sizes="(max-width: 860px) 100vw, 680px" />
            </div>
            <div class="project-text">
              <p class="project-meta">{p.status && <span class="status-badge">{p.status}</span>}<span class="idx">{p.year}</span>{p.platform}</p>
              <h3><a class="stretch" href={`/en/${p.slug}.html`}>{p.name}</a></h3>
              <p class="project-line">{p.line}</p>
              <Chips items={p.shows} />
              <dl class="spec-rows">
                <div><dt>Role</dt><dd>{p.role}</dd></div>
                <div><dt>Team</dt><dd>{p.team}</dd></div>
                {p.launch
                  ? <div><dt>Launch</dt><dd>{p.launch}</dd></div>
                  : <div><dt>Status</dt><dd>{p.status}</dd></div>}
              </dl>
              <div class="project-actions">
                <span class="cta">Read the case study <span class="arrow" aria-hidden="true">→</span></span>
                {p.store && <a class="store above" href={p.store.href} target="_blank" rel="noopener">{p.store.label} <span aria-hidden="true">↗</span></a>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="value">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">What I bring to a team</h2>
        <p class="section-title">Product design with technical fluency.</p>
      </header>
      <ol class="value-list">
        <li>
          <h3>Research that becomes decisions</h3>
          <p>Interviews, synthesis and prioritization before the final screen. On Handraw, I prioritized 6 essential requirements out of 29 with the team.</p>
          <a href="/en/handraw.html#handraw-ideacao">See the prioritization in Handraw <span aria-hidden="true">→</span></a>
        </li>
        <li>
          <h3>Clarity in complex systems</h3>
          <p>In PACE Admin, I organized about 20 management areas by frequency of use and designed the interface to explain blocked actions and prevent mistakes before asking for confirmation.</p>
          <a href="/en/pace-administrativo.html#adm-decisoes">See the decisions in PACE <span aria-hidden="true">→</span></a>
        </li>
        <li>
          <h3>Functional prototyping</h3>
          <p>I turn design decisions into interactive interfaces, using the technology that fits the project, with AI as support when it helps. That way the team reviews behavior, not just static screens.</p>
          <a href="/en/pace-torcedor.html#pace-ia">See the process in the PACE fan app <span aria-hidden="true">→</span></a>
        </li>
      </ol>
    </div>
  </section>

  <section class="journey">
    <div class="wrap">
      <header class="section-head">
        <h2 class="label">Background</h2>
        <p class="section-title">Technical training, hands-on product work.</p>
      </header>
      <table class="cv">
        <caption class="sr-only">Professional experience and education</caption>
        <tbody>
          {journey.map((j) => (
            <tr>
              <th scope="row">{j.when}</th>
              <td><strong>{j.what}</strong></td>
              <td>{j.where}</td>
            </tr>
          ))}
          <tr>
            <th scope="row">Awards</th>
            <td><strong>Hackathon podiums as product designer</strong></td>
            <td>Sindesei Tech Excellence Award 2024, outstanding student at UCB</td>
          </tr>
        </tbody>
      </table>
      <a class="text-link" href="/en/about.html#reconhecimento">Full background and awards <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
