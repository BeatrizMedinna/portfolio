<Case
  slug="pace-administrativo"
  title="PACE Admin · Product Design Case Study · Beatriz Medina"
  description="Designing PACE’s management system for the Mac: information architecture, error prevention and contextual help for people who organize college sports championships, with a SwiftUI prototype built with Claude Code."
  kicker='<span class="idx">Case 05</span>macOS · 2026'
  lede="The organizer’s system: editions, athletic clubs, brackets, schedule and matches in a native Mac app, designed to prevent mistakes that cost a lot on game day."
  chips={['Information architecture', 'Error prevention', 'Contextual help', 'macOS HIG']}
  spec={[
    ['Role', 'Product Designer · Design Engineering'],
    ['Team', '5 people at the Apple Developer Academy'],
    ['Timeline', 'October 2026'],
    ['Platform', 'macOS'],
    ['Prototype', 'SwiftUI, simulated data'],
    ['Status', 'In development'],
  ]}
  status="The screens are captures of the SwiftUI prototype running on a Mac with simulated data. The team has already connected part of the prototype to the API, but nothing here shows real data, and there has been no user testing yet."
  related={{ text: 'This is one of two connected PACE case studies.', label: 'See the PACE fan app, on iPhone', href: '/en/pace-torcedor.html' }}
  cover={{ src: 'pace-macos/cover.png', alt: 'PACE Admin prototype window on a Mac showing the edition dashboard with items needing attention, today’s games and progress' }}
  toc={[
    { id: 'resumo', label: 'Summary' },
